@model Dish
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    @if (User.IsInRole(RoleNames.Admin))
    {
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Seguro que quieres borrar este plato?');">
            <button class="btn btn-danger" type="submit">Borrar</button>
        </form>
    </div>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.DishType)</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Price €</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Restaurante</dt>
    <dd class="col-sm-9"><a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId">@Model.Restaurant?.Name</a></dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver a los platos</a>
