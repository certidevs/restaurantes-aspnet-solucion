@model Dish
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.DishType)</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Price €</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Restaurante</dt>
    <dd class="col-sm-9"><a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId">@Model.Restaurant?.Name</a></dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver a los platos</a>
