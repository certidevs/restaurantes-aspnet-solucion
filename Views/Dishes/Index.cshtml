@model List<Dish>
@{
    ViewData["Title"] = "Platos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Platos</h1>
    <a class="btn btn-success" asp-action="Create">Nuevo plato</a>
</div>
<p>Hay @Model.Count platos.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plato</th>
            <th>Tipo</th>
            <th>Precio</th>
            <th>Restaurante</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dish in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@dish.Id">@dish.Name</a></td>
                <td>@Html.DisplayFor(m => dish.DishType)</td>
                <td>@dish.Price €</td>
                <td><a asp-controller="Restaurants" asp-action="Details" asp-route-id="@dish.RestaurantId">@dish.Restaurant?.Name</a></td>
            </tr>
        }
    </tbody>
</table>
