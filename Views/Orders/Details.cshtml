@model Order
@{
    ViewData["Title"] = "Pedido " + Model.Id;
}

<h1>Pedido @Model.Id</h1>

<dl class="row">
    <dt class="col-sm-3">Restaurante</dt>
    <dd class="col-sm-9"><a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId">@Model.Restaurant?.Name</a></dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@(Model.User?.DisplayName ?? Model.User?.UserName)</dd>

    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Date.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>

    <dt class="col-sm-3">Mesa</dt>
    <dd class="col-sm-9">@Model.TableNumber</dd>

    <dt class="col-sm-3">Comensales</dt>
    <dd class="col-sm-9">@Model.NumPeople</dd>
</dl>

<h2 class="h4">Platos</h2>
<table class="table">
    <thead>
        <tr>
            <th>Plato</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.Dish?.Name</td>
                <td>@line.Dish?.Price.ToString("0.00") €</td>
                <td>@line.Quantity</td>
                <td>@((line.Dish!.Price * line.Quantity).ToString("0.00")) €</td>
                <td>
                    @if (Model.Status != OrderStatus.Completed)
                    {
                        <form asp-action="RemoveLine" method="post">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <input type="hidden" name="lineId" value="@line.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Quitar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">Propina</td>
            <td>@((Model.Tip ?? 0).ToString("0.00")) €</td>
            <td></td>
        </tr>
        <tr class="fw-bold">
            <td colspan="3" class="text-end">Total</td>
            <td>@Model.TotalPrice.ToString("0.00") €</td>
            <td></td>
        </tr>
    </tfoot>
</table>

@if (Model.Status == OrderStatus.InProgress)
{
    <form asp-action="Finish" method="post" class="card card-body mb-4">
        <h2 class="h5">Finalizar pedido</h2>
        <input type="hidden" name="orderId" value="@Model.Id" />
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="tableNumber">Mesa</label>
                <input class="form-control" id="tableNumber" name="tableNumber" type="number" min="1" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="numPeople">Comensales</label>
                <input class="form-control" id="numPeople" name="numPeople" type="number" min="1" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="tip">Propina (€)</label>
                <input class="form-control" id="tip" name="tip" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" type="submit">Finalizar pedido</button>
            </div>
        </div>
    </form>
}

@if (ViewBag.Dishes != null)
{
    <h2 class="h4 mt-4">Añadir platos</h2>
    <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
        @foreach (var dish in (List<Dish>)ViewBag.Dishes)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 card-title">@dish.Name</h3>
                        <p class="card-text text-secondary small">@Html.DisplayFor(m => dish.DishType) · @dish.Price.ToString("0.00") €</p>
                        <form asp-action="AddDish" method="post">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <input type="hidden" name="dishId" value="@dish.Id" />
                            <button class="btn btn-sm btn-primary" type="submit">Añadir</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a class="btn btn-secondary" asp-action="Index">Volver a los pedidos</a>
